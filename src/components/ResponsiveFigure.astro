---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  sizes = "(min-width: 48rem) 42rem, calc(100vw - 2rem)",
} = Astro.props;
---

<figure class="figure">
  <Image
    src={src}
    alt={alt}
    widths={[720, 1200]}
    sizes={sizes}
    format="webp"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
